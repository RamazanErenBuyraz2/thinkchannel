{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "..",
    "outDir": "../release/electron",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node", "electron"],
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["electron/main.ts", "../server/backblaze.ts"]
}
